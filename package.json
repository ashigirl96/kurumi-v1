{
  "name": "kurumi",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "@peculiar/x509": "2.2.0",
      "@types/bun": "1.4.4",
      "drizzle-kit": "0.31.11",
      "drizzle-orm": "0.45.3",
      "oxfmt": "0.71.0",
      "oxlint": "1.86.0",
      "oxlint-tsgolint": "7.0.2003",
      "reflect-metadata": "0.2.2",
      "typescript": "7.0.2",
      "@orpc/client": "1.15.4",
      "@orpc/contract": "1.15.4",
      "@orpc/server": "1.15.4",
      "trpc-cli": "0.17.1",
      "zod": "4.6.5",
      "@anthropic-ai/claude-agent-sdk": "0.3.309"
    }
  },
  "type": "module",
  "scripts": {
    "check": "oxlint --no-error-on-unmatched-pattern --report-unused-disable-directives-severity=error && oxfmt --check && tsc --noEmit && bun test && bun test ./.agents/skills/verify",
    "generate": "bun run --filter './packages/*' --if-present generate"
  },
  "devDependencies": {
    "@kurumi/gateway": "workspace:*",
    "@types/bun": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript": "catalog:"
  },
  "packageManager": "bun@1.4.4"
}

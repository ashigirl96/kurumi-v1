#!/bin/sh
set -eu

scanner_help() {
  printf '%s\n' \
    'Secret scan required: install gitleaks v8.30.1 from https://github.com/gitleaks/gitleaks/releases/tag/v8.30.1 and put it on PATH, or install and start Docker (https://docs.docker.com/get-docker/).' \
    'To explicitly bypass this check, use git push --no-verify.' >&2
  exit 1
}

zero=0000000000000000000000000000000000000000

while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" != "$zero" ] || continue

  if [ "$remote_sha" = "$zero" ]; then
    set -- "$local_sha" --not --remotes
  else
    set -- "$remote_sha..$local_sha"
  fi
  range="$*"

  # Gitleaks can exit successfully after Git rejects a revision range.
  if ! git rev-list "$@" >/dev/null; then
    printf '%s\n' 'Secret scan failed: commit range unavailable. Run git fetch and retry, or explicitly bypass with git push --no-verify.' >&2
    exit 1
  fi

  if command -v gitleaks >/dev/null 2>&1; then
    case "$(gitleaks version </dev/null)" in
      8.30.1|v8.30.1) ;;
      *) scanner_help ;;
    esac
    gitleaks git --redact --no-banner --log-opts="-m $range" </dev/null
  elif command -v docker >/dev/null 2>&1; then
    common_dir=$(git rev-parse --path-format=absolute --git-common-dir)
    docker run --rm -v "$PWD:$PWD" -v "$common_dir:$common_dir" --workdir "$PWD" \
      zricethezav/gitleaks:v8.30.1 git --redact --no-banner --log-opts="-m $range" </dev/null
  else
    scanner_help
  fi
done
